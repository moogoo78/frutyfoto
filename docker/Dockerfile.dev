FROM node:22-bookworm-slim AS node

FROM rust:1-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config curl wget file ca-certificates xdg-utils \
      libwebkit2gtk-4.1-dev libxdo-dev libssl-dev \
      libayatana-appindicator3-dev librsvg2-dev \
      fonts-noto-core fonts-noto-cjk adwaita-icon-theme \
    && rm -rf /var/lib/apt/lists/*

# Node + pnpm (copied from the official node image)
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && npm install -g pnpm@10

ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} dev && useradd -m -u ${UID} -g ${GID} dev \
 && mkdir -p -m 700 /tmp/runtime && chown dev:dev /tmp/runtime \
 && mkdir -p /app/node_modules /app/src-tauri/target /usr/local/cargo/registry /home/dev/.local/share/pnpm \
 && chown -R dev:dev /app /usr/local/cargo /usr/local/rustup /home/dev

USER dev
WORKDIR /app
ENV CARGO_TERM_COLOR=always \
    npm_config_store_dir=/home/dev/.local/share/pnpm/store \
    CI=true
