{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "frutyfoto",
  "version": "0.1.0",
  "identifier": "io.github.moogoo78.frutyfoto",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "frutyfoto", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 500, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
